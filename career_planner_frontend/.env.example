# PUBLIC_INTERFACE
# Frontend environment variables for Career Planner
# Copy this file to .env and adjust values for your environment.

# Base URL for the FastAPI backend (e.g., http://localhost:3001)
REACT_APP_BACKEND_URL=http://localhost:3001

# Supabase configuration (required for auth-enabled pages)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Optional: frontend site URL used for auth email redirects
REACT_APP_SITE_URL=
