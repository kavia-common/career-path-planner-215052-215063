# Frontend environment variables (copy this file to .env and fill values)
# Backend API base URL (no trailing slash). During development, if not set,
# the app will infer http(s)://<current-host>:3001
REACT_APP_BACKEND_URL=https://your-backend-host:3001

# Supabase project config
# Obtain these from your Supabase project settings
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Site URL used for Supabase email confirmations/redirects
# If not set, defaults to window.location.origin at runtime
REACT_APP_SITE_URL=https://your-frontend-host
